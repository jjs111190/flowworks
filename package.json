{
  "name": "flowworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:api:free": "FLOWWORKS_DATA_PATH=backend/data/flowworks.json tsx watch backend/src/server.ts",
    "start:api": "tsx backend/src/server.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "build:pwa": "npm run pwa:icons && npm run build",
    "build:native": "npm run build:pwa && npx cap sync && npm run pwa:icons",
    "ios:add": "npm run build:pwa && npx cap add ios && npm run pwa:icons",
    "ios:sync": "npm run build:pwa && npx cap sync ios && npm run pwa:icons",
    "ios:open": "npx cap open ios",
    "android:add": "npm run build:pwa && npx cap add android && npm run pwa:icons",
    "android:sync": "npm run build:pwa && npx cap sync android && npm run pwa:icons",
    "android:open": "npx cap open android",
    "deploy:cloudflare": "npm run build:pwa && npx wrangler pages deploy dist --project-name flowworks",
    "deploy:static:check": "npm run build:pwa && node scripts/verify-static-build.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@prisma/client": "^5.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
